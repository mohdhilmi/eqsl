<%- include('../partials/header') %>
<h1>Enter Timings</h1>
<%- include('../partials/filter-form') %>

<% if (categoryId && disciplineId) { %>
  <% if (round === 'final' && participants.length === 0) { %>
    <p>No qualifiers yet for this category &amp; discipline. Record qualifying timings first.</p>
  <% } else if (participants.length === 0) { %>
    <p>No participants registered for this category yet.</p>
  <% } else { %>
    <p class="hint">Enter time as <code>MM:SS:CS</code> (e.g. <code>00:05:42</code> = 5.42 seconds). Leave as <code>00:00:00</code> for DNF / not recorded. Best time is computed automatically.</p>
    <form method="post" action="/admin/timings">
      <input type="hidden" name="category_id"   value="<%= categoryId %>">
      <input type="hidden" name="discipline_id" value="<%= disciplineId %>">
      <input type="hidden" name="round"         value="<%= round %>">
      <table class="results">
        <thead><tr>
          <th>Bib</th><th>Name</th><th>A1</th><th>A2</th><th>A3</th>
        </tr></thead>
        <tbody>
          <% participants.forEach(p => { %>
            <tr>
              <td><%= p.bib_no || '' %></td>
              <td><%= p.full_name %></td>
              <% for (let n = 1; n <= 3; n++) {
                   const ms = (existing[p.id] || {})[n];
                   const display = ms == null ? '00:00:00' : formatMs(ms);
              %>
                <td><input name="times[p<%= p.id %>][a<%= n %>]" value="<%= display %>" placeholder="00:00:00" inputmode="numeric" pattern="[0-9:]*" style="width: 7em; font-variant-numeric: tabular-nums;"></td>
              <% } %>
            </tr>
          <% }) %>
        </tbody>
      </table>
      <button class="btn primary" type="submit">Save Timings</button>
    </form>
  <% } %>
<% } else { %>
  <p>Pick a category, discipline, and round to enter timings.</p>
<% } %>
<%- include('../partials/footer') %>
