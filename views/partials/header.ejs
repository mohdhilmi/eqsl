<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title><%= typeof title !== 'undefined' ? title : 'eQSL Sports Stacking' %></title>
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>
  <header class="topbar">
    <a class="brand" href="/">eQSL &middot; Sports Stacking</a>
    <nav>
      <a href="/register">Register</a>
      <a href="/results">Results</a>
      <% if (user) { %>
        <a href="/admin">Dashboard</a>
        <a href="/admin/participants">Participants</a>
        <a href="/admin/timings">Timings</a>
        <a href="/admin/results">Results Admin</a>
        <form method="post" action="/admin/logout" class="inline">
          <button class="link" type="submit">Logout (<%= user.username %>)</button>
        </form>
      <% } else { %>
        <a href="/admin/login">Admin</a>
      <% } %>
    </nav>
  </header>

  <% if (flash) { %>
    <div class="flash <%= flash.type %>"><%= flash.msg %></div>
  <% } %>

  <main class="container">
